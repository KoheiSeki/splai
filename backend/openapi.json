    "/api/groups/{group_id}/ocr/upload": {
      "post": {
        "tags": [
          "ocr"
        ],
        "summary": "Upload Receipt",
        "description": "レシート画像を受け取り OCR ジョブを起動する。\n\n認可は `Depends(require_member)` が path の `group_id` と `X-Member-Id` を\n照合して完了させる(`MemberMismatch` を内部で投げる)。本ハンドラでは\ncontent-type / size 検証 → Storage upload → DB INSERT → background OCR 起動のみ。",
        "operationId": "upload_receipt_api_groups__group_id__ocr_upload_post",
        "parameters": [
          {
            "name": "group_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Group Id"
            }
          },
          {
            "name": "X-Member-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "X-Member-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_receipt_api_groups__group_id__ocr_upload_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OcrUploadResponse"
