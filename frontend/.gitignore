# =====================================================================
# Frontend .gitignore — Next.js / Node.js 特有のパターン
# OS / Editor / 環境変数 / ログ等は ../.gitignore (repo root) を参照
# =====================================================================

# dependencies (Node.js)
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js build artifacts
/.next/
/out/
/build

# testing
/coverage

# typescript
*.tsbuildinfo
next-env.d.ts

# Node.js package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel CLI
.vercel

# Sentry build plugin token (@sentry/wizard が自動生成)
.env.sentry-build-plugin

# misc
*.pem
